# Copiar este archivo como .env (cp .env.example .env) y llenar los valores.
# Se sacan del panel de Supabase: Project Settings > API.
 
# URL del proyecto, ej: https://abcdefghijk.supabase.co
VITE_SUPABASE_URL=
 
# Llave pública (anon o publishable). NUNCA poner la service_role aquí.
VITE_SUPABASE_ANON_KEY=